# Copy this file to .env and fill in your real values.
# .env is git-ignored; this example file is safe to commit.

# Port the Express server listens on
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-response-rater

# Your AI provider's API key, e.g. ANTHROPIC_API_KEY=... or OPENAI_API_KEY=...
# (we'll set the exact name in Weekend 1 once you pick a provider)
